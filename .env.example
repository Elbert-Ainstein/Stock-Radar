# ─── Stock Radar environment ───
# Copy this file to .env and fill in your keys. NEVER commit .env to git.
# Variable names below match what the code actually reads
# (scripts/supabase_helper.py, scripts/finance_data.py, lib/supabase.ts —
# reconciled 2026-07-02; the old example listed unused OPENAI/TELEGRAM keys
# and omitted Supabase/EODHD entirely).

# ── Supabase (scouts, analyst, theses, seals — required) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Next.js client-side fallbacks (only needed if the above are not inherited)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── LLMs ──
# Claude — thesis/socratic/judgment money path, model generation, kill conditions
ANTHROPIC_API_KEY=
# Perplexity Sonar — forward research, news, catalysts
PERPLEXITY_API_KEY=
# Gemini — YouTube transcript analysis
GEMINI_API_KEY=

# ── Financial data ──
# EODHD — primary financial data provider
EODHD_API_KEY=
# Alpha Vantage — fallback financial data
ALPHA_VANTAGE_API_KEY=

# ── Operations ──
# Shared secret for mutating /api routes (middleware.ts). Unset = auth off.
# Enroll a browser once via  http://localhost:3000/?sr_key=<value>
SR_API_SECRET=

# Socratic self-consistency: production sealed runs use mode-of-5
# (HANDOFF_PRD 2026-06-24 decision; code default is 1 = single-sample).
# SELF_CONSISTENCY_N=5
